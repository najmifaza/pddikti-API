# Salin ke .env lalu sesuaikan. Semua variabel opsional.

# Port HTTP layanan (dipakai saat menjalankan uvicorn --port, atau lewat systemd)
PORT=8090

# Jika diisi, semua endpoint /api/* wajib menyertakan header X-API-Key
API_KEY=

# Daftar origin CORS yang diizinkan, dipisah koma. Kosong = semua origin (*)
CORS_ORIGINS=

# Batas request /api/* per IP klien per menit. 0 = nonaktif
RATE_LIMIT_PER_MINUTE=30

# Panjang minimal parameter q pada /api/search
SEARCH_MIN_QUERY_LEN=3

# IP/CIDR reverse proxy yang dipercaya untuk X-Forwarded-For / X-Real-IP, dipisah koma.
# Kosong = tidak percaya proxy mana pun (pakai IP koneksi langsung)
TRUSTED_PROXIES=

# Opsional: sesi PDDIKTI untuk request upstream (nilai header Cookie mentah).
# Isi hanya bila upstream menolak request tanpa sesi. Jangan commit nilai asli.
PDDIKTI_COOKIE=

# Opsional: User-Agent upstream. Kosong = User-Agent peramban bawaan kode.
PDDIKTI_USER_AGENT=

# Hanya untuk tests/live_test.py. Jangan commit data asli.
PDDIKTI_TEST_NIM=
PDDIKTI_TEST_KAMPUS=